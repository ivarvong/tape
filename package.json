{
  "name": "tape",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A small language for durable services, compiled to WebAssembly: it runs in the browser, in Node and on Cloudflare Workers, and every effect is recorded.",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "test": "node proof/all.ts --quick",
    "check": "node proof/all.ts",
    "check:changed": "node proof/all.ts --changed",
    "fast": "node proof/fast.ts",
    "hooks": "sh proof/install-hooks.sh",
    "types": "tsc --noEmit",
    "lint": "node proof/lint.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
